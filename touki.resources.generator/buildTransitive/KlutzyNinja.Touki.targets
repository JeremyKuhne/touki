<Project>
  <!-- Keep localized resources nested under their neutral resource in Solution Explorer. -->
  <ItemGroup>
    <EmbeddedResource Update="**\*.??.resx;**\*.??-??.resx;**\*.??-????.resx"
                      DependentUpon="$([System.IO.Path]::ChangeExtension($([System.IO.Path]::GetFileNameWithoutExtension(%(Identity))), '.resx'))" />
  </ItemGroup>

  <Target Name="ToukiAddResxFilesAsAdditionalFiles"
          DependsOnTargets="PrepareResourceNames"
          AfterTargets="AddAllResxFilesAsAdditionalFiles;AddGenerateSourceResxFilesAsAdditionalFiles"
          BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile"
          Condition="'@(EmbeddedResource)' != ''">
    <ItemGroup>
      <EmbeddedResource Update="@(EmbeddedResource)"
                        Condition="'%(EmbeddedResource.Extension)' == '.resx'">
        <ToukiResourceFamily>%(EmbeddedResource.ManifestResourceName)</ToukiResourceFamily>
        <ToukiResourceFamily Condition="'%(EmbeddedResource.Culture)' != ''
                                        And $([System.String]::Copy('%(EmbeddedResource.ManifestResourceName)').EndsWith('.%(EmbeddedResource.Culture)'))">$([System.String]::Copy('%(EmbeddedResource.ManifestResourceName)').Substring(0, $([System.String]::Copy('%(EmbeddedResource.ManifestResourceName)').LastIndexOf('.%(EmbeddedResource.Culture)'))))</ToukiResourceFamily>
      </EmbeddedResource>

      <EmbeddedResource Update="@(EmbeddedResource)"
                        Condition="'%(EmbeddedResource.Extension)' == '.resx'
                                   And '%(EmbeddedResource.Generator)' == 'Touki'">
        <ToukiGenerateSource Condition="'%(EmbeddedResource.GenerateSource)' == 'true'">true</ToukiGenerateSource>
        <ToukiGenerateSource Condition="'%(EmbeddedResource.GenerateSource)' != 'true'
                                        And '%(EmbeddedResource.GenerateSource)' != 'false'
                                        And '%(EmbeddedResource.WithCulture)' != 'true'">true</ToukiGenerateSource>
        <ToukiGenerateSource Condition="'%(EmbeddedResource.GenerateSource)' == 'false'
                                        Or ('%(EmbeddedResource.GenerateSource)' != 'true'
                                            And '%(EmbeddedResource.WithCulture)' == 'true')">false</ToukiGenerateSource>
        <GenerateSource>false</GenerateSource>
      </EmbeddedResource>

      <_ToukiEmbeddedResx Include="@(EmbeddedResource)"
                          Condition="'%(EmbeddedResource.Extension)' == '.resx'" />
      <AdditionalFiles Remove="@(_ToukiEmbeddedResx)" />
      <AdditionalFiles Include="@(_ToukiEmbeddedResx)" />
    </ItemGroup>
  </Target>
</Project>