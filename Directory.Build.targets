<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Workaround for .NET 10 RC2 regression: https://github.com/dotnet/sdk/issues/51265 -->
    <RestoreEnablePackagePruning Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">false</RestoreEnablePackagePruning>

    <!--
      The unsafe contexts are required by the .NET Framework build. IDE0380 analyzes each target
      independently and cannot account for that cross-target requirement, so disable it after the
      target-framework identifier is available. Modern .NET reports are suppressed individually
      in GlobalSuppressions.cs.
    -->
    <NoWarn Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">$(NoWarn);IDE0380</NoWarn>
  </PropertyGroup>

  <!--
    Versioning (MinVer)

    Centralized so packable projects derive their version from a release tag.
    The default stream is `v*`; independently released projects override the
    prefix. Imported from Directory.Build.targets (rather than props) so that a
    project's own `<IsPackable>false</IsPackable>` setting is in scope when the
    condition is evaluated.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <!-- Use the main `v*` stream unless the project selects an independent prefix. -->
    <MinVerTagPrefix Condition="'$(MinVerTagPrefix)' == ''">v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Load the full current analyzer in every first-party project. Touki already loads the analyzer project through
    specialized build/package references. The bootstrap project links the same analyzer sources so analyzer
    producers can enforce every rule without referencing their own output.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'touki'
                        And '$(MSBuildProjectName)' != 'touki.analyzers.bootstrap'">
    <ProjectReference Include="$(RepoDir)touki.analyzers.bootstrap\touki.analyzers.bootstrap.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- In-repo package consumers can restore a published Touki analyzer transitively. Keep only the local build. -->
  <Target Name="_RemovePackagedToukiAnalyzers"
      AfterTargets="ResolveLockFileAnalyzers"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_PackagedToukiAnalyzer Include="@(Analyzer)"
                              Condition="'%(Analyzer.NuGetPackageId)' == 'KlutzyNinja.Touki.Analyzers'" />
      <Analyzer Remove="@(_PackagedToukiAnalyzer)" />
    </ItemGroup>
  </Target>
</Project>