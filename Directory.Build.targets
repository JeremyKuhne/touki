<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Workaround for .NET 10 RC2 regression: https://github.com/dotnet/sdk/issues/51265 -->
    <RestoreEnablePackagePruning Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <!--
    Versioning (MinVer)

    Centralized so packable projects derive their version from a release tag.
    The default stream is `v*`; independently released projects override the
    prefix. Imported from Directory.Build.targets (rather than props) so that a
    project's own `<IsPackable>false</IsPackable>` setting is in scope when the
    condition is evaluated.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <!-- Use the main `v*` stream unless the project selects an independent prefix. -->
    <MinVerTagPrefix Condition="'$(MinVerTagPrefix)' == ''">v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>