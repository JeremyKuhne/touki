<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platforms>x64;AnyCPU</Platforms>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Touki.Analyzers</RootNamespace>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <PolySharpIncludeGeneratedTypes>
      System.Diagnostics.CodeAnalysis.NotNullWhenAttribute
    </PolySharpIncludeGeneratedTypes>

    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\klutzyninja.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"
                      VersionOverride="$(ToukiAnalyzerRoslynVersion)"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bootstrap cannot analyze its own output. Keep all source in the analyzer project and link it below. -->
    <_BootstrapOwnedSource Include="**\*.cs" Exclude="$(DefaultItemExcludes)" />
    <Compile Include="..\touki.analyzers\**\*.cs"
             Exclude="..\touki.analyzers\bin\**;..\touki.analyzers\obj\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AdditionalFiles Include="..\touki.analyzers\AnalyzerReleases.Shipped.md"
                     Link="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="..\touki.analyzers\AnalyzerReleases.Unshipped.md"
                     Link="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <Target Name="_RejectBootstrapOwnedSource"
          BeforeTargets="CoreCompile"
          Condition="'@(_BootstrapOwnedSource)' != ''">
    <Error Text="Bootstrap-owned C# source cannot be analyzed by this project: @(_BootstrapOwnedSource)" />
  </Target>

</Project>