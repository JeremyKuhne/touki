<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platforms>x64;AnyCPU</Platforms>

    <!--
      Code-fix providers reference the Roslyn Workspaces APIs, which must not live in the analyzer assembly
      (RS1022). They ship in a separate assembly inside the KlutzyNinja.Touki.Analyzers package under
      analyzers/dotnet/cs. netstandard2.0 allows the IDE to load it.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Touki.Analyzers</RootNamespace>

    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Keep the code-fix assembly identity aligned with the analyzer package that contains it. -->
    <MinVerTagPrefix>analyzers-v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.9</MinVerMinimumMajorMinor>

    <!-- Not a security boundary, the strong name is for identity and ease of use from other signed assemblies. -->
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\klutzyninja.snk</AssemblyOriginatorKeyFile>

    <_ToukiBootstrapRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</_ToukiBootstrapRoot>
    <_ToukiBootstrapPackage>$(_ToukiBootstrapRoot)klutzyninja.touki.analyzers/$(ToukiBootstrapAnalyzerVersion)</_ToukiBootstrapPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="KlutzyNinja.Touki.Analyzers" Version="[$(ToukiBootstrapAnalyzerVersion)]" />
    <Analyzer Include="$(_ToukiBootstrapPackage)/analyzers/dotnet/cs/touki.analyzers.dll" />
    <!-- Brings CodeFixProvider, Document, CodeAction, and SyntaxGenerator (and CodeAnalysis.CSharp transitively). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\touki.analyzers\AllmanFormatter.cs" Link="Shared\AllmanFormatter.cs" />
    <Compile Include="..\touki.analyzers\AllmanFormatter.BlankLineChange.cs"
             Link="Shared\AllmanFormatter.BlankLineChange.cs" />
    <Compile Include="..\touki.analyzers\AllmanFormatter.BracePair.cs"
             Link="Shared\AllmanFormatter.BracePair.cs" />
    <Compile Include="..\touki.analyzers\AllmanFormatter.LineLayout.cs"
             Link="Shared\AllmanFormatter.LineLayout.cs" />
    <Compile Include="..\touki.analyzers\AllmanFormatter.PreprocessorLineKind.cs"
             Link="Shared\AllmanFormatter.PreprocessorLineKind.cs" />
    <Compile Include="..\touki.analyzers\AllmanFormatter.PreprocessorLineMap.cs"
             Link="Shared\AllmanFormatter.PreprocessorLineMap.cs" />
    <Compile Include="..\touki.analyzers\AllmanFormatter.PreprocessorLineMap.LineRange.cs"
             Link="Shared\AllmanFormatter.PreprocessorLineMap.LineRange.cs" />
    <Compile Include="..\touki.analyzers\AllmanFormattingOptions.cs"
             Link="Shared\AllmanFormattingOptions.cs" />
    <Compile Include="..\touki.analyzers\AnalyzerConfigOptionsExtensions.cs"
             Link="Shared\AnalyzerConfigOptionsExtensions.cs" />
    <Compile Include="..\touki.analyzers\StatementBreakChangeKind.cs"
         Link="Shared\StatementBreakChangeKind.cs" />
    <Compile Include="..\touki.analyzers\StatementBreakDiagnosticData.cs"
         Link="Shared\StatementBreakDiagnosticData.cs" />
    <Compile Include="..\touki.analyzers\StatementBreakFixAllBudget.cs"
         Link="Shared\StatementBreakFixAllBudget.cs" />
    <Compile Include="..\touki.analyzers\StatementBreakFormatting.cs"
         Link="Shared\StatementBreakFormatting.cs" />
    <Compile Include="..\touki.analyzers\StatementBreakFormatting.OperatorPrecedence.cs"
         Link="Shared\StatementBreakFormatting.OperatorPrecedence.cs" />
    <Compile Include="..\touki.analyzers\StatementBreakFormattingOptions.cs"
         Link="Shared\StatementBreakFormattingOptions.cs" />
    <Compile Include="..\touki.analyzers\StatementBreakIndentation.cs"
         Link="Shared\StatementBreakIndentation.cs" />
    <Compile Include="..\touki.analyzers\StatementBreakOperator.cs"
         Link="Shared\StatementBreakOperator.cs" />
  </ItemGroup>

</Project>
