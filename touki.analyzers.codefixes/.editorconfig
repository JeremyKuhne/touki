[*.cs]
# Code-fix implementation helpers are not public package API. Public provider types and members remain documented.
dotnet_code_quality.TOUKI0025.api_surface = public
dotnet_code_quality.TOUKI0025.effective_api_surface = public
dotnet_code_quality.TOUKI0026.api_surface = public
dotnet_code_quality.TOUKI0026.effective_api_surface = public

# Loading the full local analyzer exposes existing producer debt. Keep these rules visible while
# migrating the code-fix implementation without blocking unrelated analyzer changes.
dotnet_diagnostic.TOUKI0026.severity = suggestion
dotnet_diagnostic.TOUKI0027.severity = suggestion
dotnet_diagnostic.TOUKI0028.severity = suggestion
dotnet_diagnostic.TOUKI0029.severity = suggestion
