# Ported BCL polyfills
#
# Code under this folder is ported as faithfully as possible from dotnet/runtime
# to ease future updates from upstream (see polyfills.instructions.md). Touki's own
# opinionated analyzers should not force idiomatic rewrites of this ported code.
[*.cs]

# TOUKI0001: Use pattern matching for null checks
dotnet_diagnostic.TOUKI0001.severity = none

# TOUKI0020: Declare one type per file. Upstream keeps helper structs nested next to the
# code that uses them; splitting them would make future ports harder to diff.
dotnet_diagnostic.TOUKI0020.severity = none

# TOUKI0024: Format XML documentation as nested XML. Upstream documentation layout is retained
# so future ports remain easy to compare.
dotnet_diagnostic.TOUKI0024.severity = none

# TOUKI0027: Use Allman formatting. Upstream source layout is retained so future ports remain
# easy to compare.
dotnet_diagnostic.TOUKI0027.severity = none

# TOUKI0028: Format statement breaks. Upstream operator placement is retained so future ports
# remain easy to compare.
dotnet_diagnostic.TOUKI0028.severity = none

# TOUKI0029: Name literal arguments. Upstream call-site syntax is retained so future ports remain
# easy to compare.
dotnet_diagnostic.TOUKI0029.severity = none

# TOUKI0026: Require member, parameter, and return XML documentation. Upstream documentation
# coverage is retained so future ports remain easy to compare.
dotnet_diagnostic.TOUKI0026.severity = none

# TOUKI0030: Use ValueStringBuilder to build strings. Upstream builds these strings with
# StringBuilder; rewriting them would make future ports harder to diff.
dotnet_diagnostic.TOUKI0030.severity = none

# TOUKI0041: Naming rule violation. Upstream names these members to its own conventions -
# camelCase enum members in ExceptionArgument, unprefixed private fields, embedded underscores -
# and renaming them would make future ports harder to diff.
dotnet_diagnostic.TOUKI0041.severity = none
